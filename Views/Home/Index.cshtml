@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center py-5">
    <h1 class="display-4 fw-bold text-primary">Student Registration System</h1>
    <p class="lead text-muted mt-3 mb-4">
        Register new students, validate their details, and manage all records in one place.
    </p>
    <div class="d-flex gap-3 justify-content-center flex-wrap">
        <a asp-controller="Students" asp-action="Create" class="btn btn-primary btn-lg px-4">Register a Student</a>
        <a asp-controller="Students" asp-action="Index" class="btn btn-outline-primary btn-lg px-4">View Students</a>
    </div>
</div>
